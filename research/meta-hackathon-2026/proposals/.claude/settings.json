{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git ls-remote *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * merge *)",
      "Bash(git -C * tag *)",
      "Bash(git -c * commit *)",
      "Bash(git -c * push *)",
      "Bash(gh *)",
      "Bash(curl *github*)",
      "Bash(wget *github*)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git tag *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clone *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git ls-remote *)",
      "PowerShell(git -C * commit *)",
      "PowerShell(git -C * push *)",
      "PowerShell(gh *)",
      "PowerShell(curl *github*)",
      "PowerShell(Invoke-WebRequest *github*)",
      "PowerShell(Invoke-RestMethod *github*)",
      "PowerShell(iwr *github*)",
      "PowerShell(irm *github*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:*.githubusercontent.com)",
      "WebFetch(domain:github.io)",
      "WebFetch(domain:*.github.io)",
      "mcp__github__*",
      "mcp__plugin_github_github__*"
    ],
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git worktree *)",
      "Bash(git stash *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(npx *)",
      "Bash(docker pull *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "PowerShell(git worktree *)",
      "PowerShell(git stash *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(npx *)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/docs/governance/**)",
      "Edit(/.github/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
